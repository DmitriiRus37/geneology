exports[`on a phone a tab that cannot save says so in the head of the sheet too, with the way out 1`] = `
"<div class=\\"rail-head\\"><div class=\\"grab\\" role=\\"button\\" tabindex=\\"0\\" aria-expanded=\\"false\\" aria-label=\\"Развернуть\\" title=\\"Развернуть\\"><span></span></div><h1>Родословная</h1><p>Добавьте человека, выберите его на древе — и растите ветку стрелками.</p><div class=\\"find\\"><input id=\\"search\\" type=\\"text\\" enterKeyHint=\\"search\\" autoComplete=\\"off\\" autoCorrect=\\"off\\" spellCheck=\\"false\\" placeholder=\\"Найти человека\\" value=\\"\\"/></div><button class=\\"primary add-big\\" aria-label=\\"+ Добавить человека\\">+ Добавить</button><div class=\\"head-stuck\\"><div class=\\"where stuck\\">Древо изменилось в другом месте — правки не сохраняются</div><button class=\\"primary\\">Перечитать с диска</button></div></div>"
`;

exports[`the add card, for a relative and on its own 1`] = `
{
  "child": "<div class=\\"pop\\" style=\\"left:10px;top:20px\\"><h3>Ребёнок для: <b>Фёдор Михайлович Орлов</b></h3><p class=\\"who-for\\">Кем он будет для «Фёдор Михайлович Орлов»?</p><div class=\\"choice\\"><button class=\\"\\" title=\\"Родитель для «Фёдор Михайлович Орлов»\\">↑ Родитель</button><button class=\\"on\\" title=\\"Ребёнок для «Фёдор Михайлович Орлов»\\">↓ Ребёнок</button><button class=\\"\\" title=\\"Супруг для «Фёдор Михайлович Орлов»\\">⚭ Супруг</button><button class=\\"\\" title=\\"Брат или сестра для «Фёдор Михайлович Орлов»\\">↔ Брат/сестра</button><button class=\\"\\" title=\\"Ни с кем не связывать\\">Сам по себе</button></div><input type=\\"text\\" placeholder=\\"Имя Отчество Фамилия\\" autoComplete=\\"off\\" value=\\"\\"/><div class=\\"row dates\\"><input type=\\"text\\" placeholder=\\"Родился, 01.12.1995\\" autoComplete=\\"off\\" value=\\"\\"/><input type=\\"text\\" placeholder=\\"Умер, 17.10.2005\\" autoComplete=\\"off\\" value=\\"\\"/></div><div class=\\"seg\\" title=\\"Пол: по умолчанию угадывается по имени и отчеству\\"><button class=\\"on\\">По имени</button><button class=\\"\\">♂︎ Муж.</button><button class=\\"\\">♀︎ Жен.</button></div><div class=\\"row\\"><button class=\\"primary\\" disabled=\\"\\">Добавить</button><button class=\\"quiet\\">Отмена</button></div></div>",
  "alone": "<div class=\\"pop\\" style=\\"left:10px;top:20px\\"><h3>Новый человек</h3><input type=\\"text\\" placeholder=\\"Имя Отчество Фамилия\\" autoComplete=\\"off\\" value=\\"\\"/><div class=\\"row dates\\"><input type=\\"text\\" placeholder=\\"Родился, 01.12.1995\\" autoComplete=\\"off\\" value=\\"\\"/><input type=\\"text\\" placeholder=\\"Умер, 17.10.2005\\" autoComplete=\\"off\\" value=\\"\\"/></div><div class=\\"seg\\" title=\\"Пол: по умолчанию угадывается по имени и отчеству\\"><button class=\\"on\\">По имени</button><button class=\\"\\">♂︎ Муж.</button><button class=\\"\\">♀︎ Жен.</button></div><div class=\\"row\\"><button class=\\"primary\\" disabled=\\"\\">Добавить</button><button class=\\"quiet\\">Отмена</button></div><p class=\\"hintline\\">Человек появится сам по себе. Чтобы сразу пристроить его к родне, выберите кого-нибудь на древе и нажмите стрелку у карточки.</p></div>"
}
`;

exports[`the bar over the canvas, with and without hidden people 1`] = `
{
  "plain": "<div id=\\"tools\\" class=\\"\\"><label class=\\"sw\\" title=\\"Ставить людей по году рождения\\"><input type=\\"checkbox\\"/><span class=\\"track\\"></span>По годам</label><label class=\\"rng\\" title=\\"Расстояние между карточками\\">Просвет<input type=\\"range\\" min=\\"0.6\\" max=\\"2.4\\" step=\\"0.1\\" value=\\"1\\"/></label><button title=\\"Подобрать масштаб так, чтобы всё древо поместилось в окно\\">Показать всё</button><button class=\\"rearrange\\" title=\\"Забыть, куда вы перетаскивали карточки, и разложить древо заново\\">Расставить заново</button><button title=\\"Отдалить\\">−</button><button title=\\"Приблизить\\">+</button><button id=\\"toolsMore\\" title=\\"Ещё\\" aria-expanded=\\"false\\">⋯</button></div>",
