exports[`the footer for each place the tree can live 1`] = `
{
  "disk": "<div class=\\"rail-foot\\"><p class=\\"where disk\\">Каждая правка пишется в /data/persons</p><div class=\\"fgroup\\"><button class=\\"quiet\\">Отменить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Скачать архив</button><button class=\\"quiet\\">Сохранить в файл</button><button class=\\"quiet\\">Открыть файл</button><button class=\\"quiet danger\\">Очистить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Картинка SVG</button><button class=\\"quiet\\">Картинка PNG</button><button class=\\"quiet\\">PDF</button></div><div class=\\"fgroup last\\"><div class=\\"seg langs\\" title=\\"Язык интерфейса\\"><button class=\\"on\\">RU</button><button class=\\"\\">EN</button></div><button class=\\"quiet\\">Админка</button></div><input type=\\"file\\" accept=\\".zip,application/zip\\" hidden=\\"\\"/><input type=\\"file\\" accept=\\".json,application/json\\" hidden=\\"\\"/></div></aside>",
  "memoryWithAdmin": "<div class=\\"rail-foot\\"><p class=\\"where mem\\">Древо живёт в памяти сервера. Скачайте архив: с перезапуском правки пропадут.</p><div class=\\"fgroup\\"><button class=\\"quiet\\">Отменить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Загрузить архив</button><button class=\\"quiet\\">Скачать архив</button><button class=\\"quiet danger\\">Очистить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Картинка SVG</button><button class=\\"quiet\\">Картинка PNG</button><button class=\\"quiet\\">PDF</button></div><div class=\\"fgroup last\\"><div class=\\"seg langs\\" title=\\"Язык интерфейса\\"><button class=\\"on\\">RU</button><button class=\\"\\">EN</button></div><button class=\\"quiet\\">Админка</button><button class=\\"quiet logout\\">Выйти</button></div><input type=\\"file\\" accept=\\".zip,application/zip\\" hidden=\\"\\"/><input type=\\"file\\" accept=\\".json,application/json\\" hidden=\\"\\"/></div></aside>",
  "browser": "<div class=\\"rail-foot\\"><p class=\\"where browser\\">Сохраняется в браузере — на диск не пишется</p><div class=\\"fgroup\\"><button class=\\"quiet\\">Отменить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Сохранить в файл</button><button class=\\"quiet\\">Открыть файл</button><button class=\\"quiet danger\\">Очистить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Картинка SVG</button><button class=\\"quiet\\">Картинка PNG</button><button class=\\"quiet\\">PDF</button></div><div class=\\"fgroup last\\"><div class=\\"seg langs\\" title=\\"Язык интерфейса\\"><button class=\\"on\\">RU</button><button class=\\"\\">EN</button></div></div><input type=\\"file\\" accept=\\".zip,application/zip\\" hidden=\\"\\"/><input type=\\"file\\" accept=\\".json,application/json\\" hidden=\\"\\"/></div></aside>",
  "conflict": "<div class=\\"rail-foot\\"><p class=\\"where stuck\\">Древо на диске изменилось в другом месте. Правки сюда не пишутся.</p><button class=\\"primary\\" style=\\"flex:0 0 100%;margin-bottom:6px\\">Перечитать с диска</button><div class=\\"fgroup\\"><button class=\\"quiet\\">Отменить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Скачать архив</button><button class=\\"quiet\\">Сохранить в файл</button><button class=\\"quiet\\">Открыть файл</button><button class=\\"quiet danger\\">Очистить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Картинка SVG</button><button class=\\"quiet\\">Картинка PNG</button><button class=\\"quiet\\">PDF</button></div><div class=\\"fgroup last\\"><div class=\\"seg langs\\" title=\\"Язык интерфейса\\"><button class=\\"on\\">RU</button><button class=\\"\\">EN</button></div><button class=\\"quiet\\">Админка</button></div><input type=\\"file\\" accept=\\".zip,application/zip\\" hidden=\\"\\"/><input type=\\"file\\" accept=\\".json,application/json\\" hidden=\\"\\"/></div></aside>",
  "stale": "<div class=\\"rail-foot\\"><p class=\\"where stuck\\">Сервер работает из старой версии. Перезапустите его (npm start) — до этого правки не сохраняются.</p><button class=\\"primary\\" style=\\"flex:0 0 100%;margin-bottom:6px\\">Проверить сервер заново</button><div class=\\"fgroup\\"><button class=\\"quiet\\">Отменить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Скачать архив</button><button class=\\"quiet\\">Сохранить в файл</button><button class=\\"quiet\\">Открыть файл</button><button class=\\"quiet danger\\">Очистить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Картинка SVG</button><button class=\\"quiet\\">Картинка PNG</button><button class=\\"quiet\\">PDF</button></div><div class=\\"fgroup last\\"><div class=\\"seg langs\\" title=\\"Язык интерфейса\\"><button class=\\"on\\">RU</button><button class=\\"\\">EN</button></div><button class=\\"quiet\\">Админка</button></div><input type=\\"file\\" accept=\\".zip,application/zip\\" hidden=\\"\\"/><input type=\\"file\\" accept=\\".json,application/json\\" hidden=\\"\\"/></div></aside>",
  "unknown": "<div class=\\"rail-foot\\"><p class=\\"where \\">…</p><div class=\\"fgroup\\"><button class=\\"quiet\\">Отменить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Сохранить в файл</button><button class=\\"quiet\\">Открыть файл</button><button class=\\"quiet danger\\">Очистить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Картинка SVG</button><button class=\\"quiet\\">Картинка PNG</button><button class=\\"quiet\\">PDF</button></div><div class=\\"fgroup last\\"><div class=\\"seg langs\\" title=\\"Язык интерфейса\\"><button class=\\"on\\">RU</button><button class=\\"\\">EN</button></div></div><input type=\\"file\\" accept=\\".zip,application/zip\\" hidden=\\"\\"/><input type=\\"file\\" accept=\\".json,application/json\\" hidden=\\"\\"/></div></aside>"
}
`;

