exports[`the side panel with someone selected shows the editor 1`] = `
"<aside id=\\"rail\\" class=\\"\\"><div class=\\"ruler\\" aria-hidden=\\"true\\"></div><div class=\\"rail-head\\"><div class=\\"grab\\" role=\\"button\\" tabindex=\\"0\\" aria-expanded=\\"true\\" aria-label=\\"Свернуть\\" title=\\"Свернуть\\"><span></span></div><h1>Родословная</h1><p>Добавьте человека, выберите его на древе — и растите ветку стрелками.</p><button class=\\"primary add-big\\">+ Добавить человека</button></div><div class=\\"rail-scroll\\"><div class=\\"block\\" id=\\"editor\\"><p class=\\"block-title\\">Родителей: 0 · детей: 1 · в браке: 1</p><input type=\\"text\\" placeholder=\\"Имя Отчество Фамилия\\" value=\\"Фёдор Михайлович Орлов\\"/><input type=\\"text\\" placeholder=\\"Девичья фамилия\\" value=\\"\\"/><div style=\\"display:flex;gap:7px\\"><input type=\\"text\\" placeholder=\\"Родился, 01.12.1995\\" autoComplete=\\"off\\" value=\\"??.??.1850\\"/><input type=\\"text\\" placeholder=\\"Умер, 17.10.2005\\" autoComplete=\\"off\\" value=\\"07.07.1916\\"/></div><input type=\\"text\\" placeholder=\\"Другие написания через запятую\\" value=\\"\\"/><div class=\\"lbl\\">Пол</div><div class=\\"seg\\"><button class=\\"on\\">Муж.</button><button class=\\"\\">Жен.</button><button class=\\"\\">Не указан</button></div><div class=\\"lbl\\" style=\\"margin-top:12px\\">Добавить рядом</div><div class=\\"row\\" style=\\"margin-top:0\\"><button>↑ Родителя</button><button>↓ Ребёнка</button><button>⚭ Супруга</button><button title=\\"При известных родителях — их ребёнок, иначе пунктирное родство\\">↔ Брата/сестру</button></div><div class=\\"lbl\\" style=\\"margin-top:12px\\">Соединить с тем, кто уже на древе</div><div class=\\"row\\" style=\\"margin-top:0\\"><button>Стрелку к ребёнку</button><button>Стрелку от родителя</button><button>Брак</button><button>Брат/сестра</button></div><div class=\\"lbl\\" style=\\"margin-top:12px\\">Родня</div><ul class=\\"kin\\"><li><span class=\\"dot\\" style=\\"background:#B05C82\\"></span><span class=\\"role\\">жена</span><span class=\\"who\\" title=\\"Показать на древе\\">Ирина Николаевна Соколова</span><span style=\\"font-size:11px\\">†1914</span><button class=\\"cut\\" title=\\"Убрать связь\\">×</button></li><li><span class=\\"dot\\" style=\\"background:#B05C82\\"></span><span class=\\"role\\">дочь</span><span class=\\"who\\" title=\\"Показать на древе\\">Мария Фёдоровна Орлова</span><span style=\\"font-size:11px\\">†1934</span><button class=\\"cut\\" title=\\"Убрать связь\\">×</button></li></ul><div class=\\"row\\"><button disabled=\\"\\" title=\\"Срезать древо вверх: спрятать предков этого человека и всё, что растёт от них, кроме него самого, его семьи и потомков\\">Скрыть предков</button><button class=\\"danger\\">Удалить человека</button></div></div><div class=\\"block\\"><input id=\\"search\\" type=\\"text\\" placeholder=\\"Найти человека\\" autoComplete=\\"off\\" value=\\"\\"/><ul id=\\"people\\"><li class=\\"\\"><span class=\\"dot\\" style=\\"background:#B05C82\\"></span><span class=\\"nm\\">Елена Сергеевна Соколова</span><span class=\\"yr\\">1898</span></li><li class=\\"\\"><span class=\\"dot\\" style=\\"background:#B05C82\\"></span><span class=\\"nm\\">Ирина Николаевна Соколова</span><span class=\\"yr\\">†1914</span></li><li class=\\"\\"><span class=\\"dot\\" style=\\"background:#B05C82\\"></span><span class=\\"nm\\">Мария Фёдоровна Орлова</span><span class=\\"yr\\">†1934</span></li><li class=\\"\\"><span class=\\"dot\\" style=\\"background:#B05C82\\"></span><span class=\\"nm\\">Наталья Сергеевна Соколова</span><span class=\\"yr\\">1906</span></li><li class=\\"\\"><span class=\\"dot\\" style=\\"background:#3A6EA5\\"></span><span class=\\"nm\\">Сергей Алексеевич Соколов</span><span class=\\"yr\\">1868–1925</span></li><li class=\\"sel\\"><span class=\\"dot\\" style=\\"background:#3A6EA5\\"></span><span class=\\"nm\\">Фёдор Михайлович Орлов</span><span class=\\"yr\\">1850–1916</span></li></ul></div></div><div class=\\"rail-foot\\"><p class=\\"where disk\\">Каждая правка пишется в /data/persons</p><div class=\\"fgroup\\"><button class=\\"quiet\\">Отменить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Скачать архив</button><button class=\\"quiet\\">Сохранить в файл</button><button class=\\"quiet\\">Открыть файл</button><button class=\\"quiet danger\\">Очистить</button></div><div class=\\"fgroup\\"><button class=\\"quiet\\">Картинка SVG</button><button class=\\"quiet\\">Картинка PNG</button><button class=\\"quiet\\">PDF</button></div><div class=\\"fgroup last\\"><div class=\\"seg langs\\" title=\\"Язык интерфейса\\"><button class=\\"on\\">RU</button><button class=\\"\\">EN</button></div><button class=\\"quiet\\">Админка</button></div><input type=\\"file\\" accept=\\".zip,application/zip\\" hidden=\\"\\"/><input type=\\"file\\" accept=\\".json,application/json\\" hidden=\\"\\"/></div></aside>"
`;
