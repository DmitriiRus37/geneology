# Copy to .env (git-ignored) and fill in; the Makefile reads it.
# Plain KEY=value lines: no quotes, no spaces around "=".

# the remote machine
PROD_HOST=
SSH_USER=root
# only for a password login; with an SSH key, leave it empty
SSHPASS=

# the login that guards the tree itself
GENEALOGY_USER=
GENEALOGY_PASS=
# optional: the only account that may open /admin
GENEALOGY_ADMIN_USER=
GENEALOGY_ADMIN_PASS=
