{
  "name": "genealogy",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && mv dist/index.html dist/genealogy.html",
    "start": "npm run build && node server.mjs",
    "serve": "node server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "node --test \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "test:update": "node --test --test-update-snapshots \"src/**/*.test.ts\" \"server/**/*.test.ts\""
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
